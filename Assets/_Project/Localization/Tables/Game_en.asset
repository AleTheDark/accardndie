    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750218
    m_Localized: Classi, tecniche e oggetti
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750219
    m_Localized: Soltanto carte nuove
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750220
    m_Localized: Soltanto oro
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750221
