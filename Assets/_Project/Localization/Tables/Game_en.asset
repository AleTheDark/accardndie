    m_Localized: 3 carte
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555841
    m_Localized: Quante carte si schierano in combattimento?
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555842
    m_Localized: Due
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555843
    m_Localized: Tre
    m_Metadata:
      m_Items: []
