    m_Localized: Due
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167275
    m_Localized: Tre
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167276
    m_Localized: Da quante carte e' composto il mazzo iniziale?
    m_Metadata:
      m_Items: []
