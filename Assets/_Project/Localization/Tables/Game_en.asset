    m_Localized: 'THREE-SEAL CONDEMNATION: {0} reaches 3 Seals and is eliminated
      automatically.'
    m_Metadata:
      m_Items:
      - rid: 7214883319116726694
  - m_Id: 6120950923694130
    m_Localized: 'SACRED SEAL: {0} receives {1} Seal(s). Total {2}/3; its Strength
      does not change and Seraphel gains +{3} against this unit.'
    m_Metadata:
      m_Items:
      - rid: 7214883319116726694
