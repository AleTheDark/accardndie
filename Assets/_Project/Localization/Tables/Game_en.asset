  - m_Id: 6120951636725761
    m_Localized: 'CAMBIO FORMA

      {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725762
    m_Localized: ' contro {effectiveDefenders[cpuTargetDecision.TargetIndex].Card.Name}
      che protegge'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725763
    m_Localized: '{arg}, {cpuTargetDecision.DefeatProbability:P0} di eliminazione{redirect}'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725764
    m_Localized: animata a durata zero
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725765
    m_Localized: Mana +5
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725766
    m_Localized: Mana +10
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725767
    m_Localized: Jolly
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725768
    m_Localized: "Ti teletrasporta subito alla scelta della stanza, anche mentre
      sei gi\xE0 dentro una stanza."
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725769
    m_Localized: Teleports you immediately to room selection, even while you are
      already inside a room.
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725770
    m_Localized: Teleportiert dich sofort zur Raumauswahl, auch wenn du dich bereits
      in einem Raum befindest.
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725771
    m_Localized: "Te teletransporta inmediatamente a la selecci\xF3n de sala, incluso
      si ya est\xE1s dentro de una."
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725772
    m_Localized: "Vous t\xE9l\xE9porte imm\xE9diatement au choix de la salle, m\xEAme
      si vous vous trouvez d\xE9j\xE0 dans une salle."
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725773
    m_Localized: 'Jolly usato: scegli la stanza in cui teletrasportarti.'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725774
    m_Localized: 'Joker used: choose the room to teleport to.'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725775
    m_Localized: "Joker benutzt: W\xE4hle den Raum, in den du dich teleportieren
      m\xF6chtest."
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725776
    m_Localized: "Comod\xEDn usado: elige la sala a la que teletransportarte."
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725777
    m_Localized: "Joker utilis\xE9 : choisissez la salle vers laquelle vous t\xE9l\xE9porter."
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725778
    m_Localized: JOLLY - teletrasporto alla scelta della stanza
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725779
    m_Localized: JOKER - teleporting to room choice
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725780
    m_Localized: JOKER - Teleport zur Raumauswahl
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725781
    m_Localized: "COMOD\xCDN - teletransporte a la elecci\xF3n de sala"
    m_Metadata:
      m_Items: []
  - m_Id: 6120951636725782
    m_Localized: "JOKER - t\xE9l\xE9portation vers le choix de salle"
    m_Metadata:
      m_Items: []
