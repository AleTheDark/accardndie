    m_Localized: 9 carte
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167278
    m_Localized: 6 carte
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167279
    m_Localized: 12 carte
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167280
    m_Localized: Quante carte compongono la mano prima di un combattimento?
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167281
    m_Localized: 9 carte
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167282
    m_Localized: 6 carte
