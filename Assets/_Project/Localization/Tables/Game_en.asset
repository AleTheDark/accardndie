    m_Localized: '{0} deals {1} damage to Seraphel. HP {2}/{3}.'
    m_Metadata:
      m_Items:
      - rid: 7214883319116726694
  - m_Id: 6120950923694127
    m_Localized: 'SERAPHEL - PHASE II: Relentless Light. Strength 10, D12, immune
      to debuffs and applies two Seals.'
    m_Metadata:
      m_Items: []
  - m_Id: 6120950923694128
    m_Localized: 'SERAPHEL: Judgement of Light on {0}.'
    m_Metadata:
      m_Items:
      - rid: 7214883319116726694
