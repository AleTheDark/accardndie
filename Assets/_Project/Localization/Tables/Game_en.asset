    m_Localized: Entrambi
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750209
    m_Localized: Se rinunci alla Sfida Veloce, la prossima stanza Mostro...
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750210
    m_Localized: Da' meta' EXP e oro
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750211
    m_Localized: Non cambia
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750212
    m_Localized: Viene saltata
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750213
    m_Localized: Le missioni giornaliere della Taverna pagano in...
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750214
    m_Localized: Oro
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750215
    m_Localized: Miele
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750216
    m_Localized: Propoli
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750217
