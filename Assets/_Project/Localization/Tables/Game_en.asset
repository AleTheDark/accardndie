    m_Localized: 1
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555851
    m_Localized: 2
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555852
    m_Localized: 3
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555853
    m_Localized: Le carte finite nel cimitero...
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555854
    m_Localized: Tornano in mano dopo un turno
    m_Metadata:
      m_Items: []
