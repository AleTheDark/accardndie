  - m_Id: 6136363111845888
    m_Localized: PROPOLIS POINTS
    m_Metadata:
      m_Items: []
  - m_Id: 6136363111845889
    m_Localized: MAXED
    m_Metadata:
      m_Items: []
  - m_Id: 6152268369793024
    m_Localized: 'The board is bare today: no quests.'
    m_Metadata:
      m_Items: []
  - m_Id: 6174791073435648
    m_Localized: IRON
    m_Metadata:
      m_Items: []
  - m_Id: 6174791098601472
