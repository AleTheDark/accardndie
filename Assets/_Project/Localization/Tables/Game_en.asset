      m_Items: []
  - m_Id: 6185852283555944
    m_Localized: Paladino
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555945
    m_Localized: Chi purifica i malus di un alleato e lo benedice?
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555946
    m_Localized: Mago
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555947
    m_Localized: Necromante
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555948
    m_Localized: Sacerdote
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555949
    m_Localized: Il Ladro, se il totale non basta a vincere...
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555950
    m_Localized: Ritira i dadi piu' bassi
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555951
    m_Localized: Ruba mana al nemico
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555952
    m_Localized: Raddoppia il suo valore
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555953
    m_Localized: L'abilita' del Guerriero somma...
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555954
    m_Localized: Due dadi Vigore uguali
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555955
    m_Localized: Il Vigore e un dado piu' piccolo
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555956
    m_Localized: Il valore di due carte
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555957
    m_Localized: Dove si sbloccano le abilita' supreme?
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555958
    m_Localized: Dal Mercante
    m_Metadata:
      m_Items: []
  - m_Id: 6185852283555959
    m_Localized: Al Santuario
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750144
    m_Localized: In Taverna
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750145
    m_Localized: Gli effetti di una suprema durano...
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750146
    m_Localized: Tutta la run
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750147
    m_Localized: Fino a fine stanza
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750148
    m_Localized: Per sempre
    m_Metadata:
      m_Items: []
  - m_Id: 6185852287750149
