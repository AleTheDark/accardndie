    m_Localized: 'SERAPHEL - 10 Mana consumati, +{0} HP: {1}/{2}.'
    m_Metadata:
      m_Items:
      - rid: 7214883319116726694
  - m_Id: 6120950923694121
    m_Localized: Not enough Mana for {0}'s supreme ability.
    m_Metadata:
      m_Items:
      - rid: 7214883319116726694
  - m_Id: 6120950923694122
    m_Localized: 'HEIST: choose an enemy. Steal 1 buff and 2 Mana, or 1 Strength
      if it has no buff.'
