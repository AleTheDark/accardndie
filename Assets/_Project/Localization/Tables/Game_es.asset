    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167274
    m_Localized: Due
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167275
    m_Localized: Tre
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167276
    m_Localized: Da quante carte e' composto il mazzo iniziale?
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167277
    m_Localized: 9 carte
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167278
    m_Localized: 6 carte
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167279
    m_Localized: 12 carte
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167280
    m_Localized: Quante carte compongono la mano prima di un combattimento?
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167281
    m_Localized: 9 carte
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167282
    m_Localized: 6 carte
    m_Metadata:
      m_Items: []
