  - m_Id: 6120950927888460
    m_Localized: "ABILIT\xC0 PASSIVA {0}"
    m_Metadata:
      m_Items:
      - rid: 7214883363307127525
  - m_Id: 6120950927888461
    m_Localized: 'SUPREMA: {0}'
    m_Metadata:
      m_Items:
