    m_Metadata:
      m_Items: []
  - m_Id: 2203246185582858
    m_Localized: RECOMPENSA OBTENIDA
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389093
    m_Localized: 'BRAGUS: Mantente en guardia. No ataca: espera el siguiente golpe
      para contraatacar.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389069
    m_Localized: 'GOLEM MODULAR:'
    m_Metadata:
      m_Items: []
