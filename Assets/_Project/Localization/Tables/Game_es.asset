    m_Metadata:
      m_Items: []
  - m_Id: 2203246185582888
    m_Localized: "MERCADO: esta carta ya est\xE1 en la baraja."
    m_Metadata:
      m_Items: []
  - m_Id: 2203246185582880
    m_Localized: "MERCADO: ya has comprado en el mostrador de tarjetas. Los objetos
      est\xE1n cerrados hasta la siguiente habitaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 2203246185583356
    m_Localized: Tres puertas. Un solo destino.
    m_Metadata:
      m_Items: []
  - m_Id: 2203246185583228
    m_Localized: "Las cartas van a tu mano y luego comenzar\xE1 el despliegue."
    m_Metadata:
      m_Items: []
  - m_Id: 2203246185582862
    m_Localized: "DEPURACI\xD3N DE BOT\xCDN: CardDatabase no encontrada."
    m_Metadata:
      m_Items: []
  - m_Id: 2203246185582914
    m_Localized: "MERCADO: Esta carta ya est\xE1 fuera del cementerio."
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388677
    m_Localized: CPU
    m_Metadata:
      m_Items: []
  - m_Id: 2203246185582908
    m_Localized: "MERCADO: Mant\xE9n al menos una alineaci\xF3n completa en tu mazo."
