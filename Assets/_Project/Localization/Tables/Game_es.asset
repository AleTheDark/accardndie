  - m_Id: 6120951649309113
    m_Localized: AccardReviewStarFilled
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309114
    m_Localized: AccardReviewStarOutline
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309115
    m_Localized: scrivi una recensione
    m_Metadata:
