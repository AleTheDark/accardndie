    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114383
    m_Localized: questo tour l'ho gia' visto
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114384
    m_Localized: Tutorial Gate Veil
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114385
    m_Localized: Tutorial Gate Halo
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114386
    m_Localized: premi qui
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114387
    m_Localized: qui c'e' un lampione
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114388
    m_Localized: per sicurezza
    m_Metadata:
      m_Items: []
