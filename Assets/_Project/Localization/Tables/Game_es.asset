  - m_Id: 6120951649308767
    m_Localized: "Ahora {0}  \u2192  {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649308768
    m_Localized: "Maintenant {0}  \u2192  {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649308769
    m_Localized: Spendi ancora {0} Propoli in questo ramo per sbloccare il rango
      {1}.
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649308770
    m_Localized: Spend {0} more Propolis in this branch to unlock tier {1}.
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649308771
    m_Localized: Gib noch {0} Propolis in diesem Zweig aus, um Rang {1} freizuschalten.
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649308772
    m_Localized: "Gasta {0} de Prop\xF3leo m\xE1s en esta rama para desbloquear el
      rango {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649308773
    m_Localized: "D\xE9pensez encore {0} Propolis dans cette branche pour d\xE9bloquer
      le rang {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649308774
    m_Localized: Servono {0} Propoli.
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649308775
    m_Localized: '{0} Propolis required.'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649308776
    m_Localized: "{0} Propolis ben\xF6tigt."
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649308777
    m_Localized: "Se requieren {0} de Prop\xF3leo."
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649308778
