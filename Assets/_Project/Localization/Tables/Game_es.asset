      m_Items: []
  - m_Id: 2203246185582774
    m_Localized: BIBLIOTECA
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388917
    m_Localized: "Elige una de las tres puertas para continuar la campa\xF1a."
    m_Metadata:
      m_Items: []
  - m_Id: 2203246185582881
    m_Localized: "MERCADO: ya has comprado art\xEDculos en el mostrador. Las cartas
      se cierran hasta la siguiente habitaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389071
