      m_Items: []
  - m_Id: 2203246181388893
    m_Localized: 'Schieri sempre 3 carte. In base alla loro composizione si attiva
      UNA sola aura, con questa priorita'':'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388894
    m_Localized: "\u2022 3 carte della stessa CLASSE  ->  Aura di Classe"
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388895
    m_Localized: "\u2022 3 cartas de la misma FACCIÓN (clases distintas) -> Aura
      de facción"
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388896
    m_Localized: "\u2022 1 Fortuza + 1 Astuta + 1 Magica  ->  Aura di Formazione"
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388897
    m_Localized: 'El Aura de clase sustituye al Aura de facción: no se acumulan.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388898
    m_Localized: "Facciones: Poder (Guerrero, Bárbaro, Paladín) \xB7 Astucia (Pícaro,
      Asesino, Cazador) \xB7 Magia (Mago, Nigromante, Sacerdote)"
    m_Metadata:
      m_Items: []
