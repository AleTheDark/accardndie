  - m_Id: 6120950927888417
    m_Localized: SCEGLI {0} CARTE
    m_Metadata:
      m_Items:
      - rid: 7214883363307127525
  - m_Id: 6120950927888418
    m_Localized: LA TUA FORMAZIONE
    m_Metadata:
      m_Items: []
  - m_Id: 6120950927888419
    m_Localized: FINE CAMPAGNA
    m_Metadata:
      m_Items: []
  - m_Id: 6120950927888420
    m_Localized: "CAP\xCDTULO COMPLETADO"
    m_Metadata:
      m_Items: []
  - m_Id: 6120950927888421
    m_Localized: "<size=30><b>+{0} EXP totali</b></size>\n\nLa ricompensa \xE8 stata
      triplicata."
    m_Metadata:
      m_Items:
      - rid: 7214883363307127525
  - m_Id: 6120950927888422
    m_Localized: "\xBFCERRAR SESI\xD3N?"
    m_Metadata:
      m_Items: []
  - m_Id: 6120950927888423
    m_Localized: "Volver\xE1s a la pantalla de inicio de sesi\xF3n. Se abandonar\xE1
      la campa\xF1a actual."
    m_Metadata:
      m_Items: []
  - m_Id: 6120950927888424
    m_Localized: BANCO POTENZIA
    m_Metadata:
      m_Items: []
  - m_Id: 6120950927888425
    m_Localized: 'RELIQUIA I: {0}

      RELIQUIA II: {1}


      Seleziona una pedina
      qui sotto.

      Ogni reliquia abilita un +1 permanente.'
    m_Metadata:
      m_Items:
      - rid: 7214883363307127525
