  - m_Id: 6120951640920168
    m_Localized: 'SERAPHEL - PHASE II: Relentless Light. Strength 10, D12, immune
      to debuffs and applies two Seals.'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951640920169
    m_Localized: "SERAPHEL - PHASE II: Unerbittliches Licht. St\xE4rke 10, W12, immun
      gegen Schw\xE4chungen und wendet zwei Siegel an."
    m_Metadata:
      m_Items: []
  - m_Id: 6120951640920170
    m_Localized: 'SERAPHEL - FASE II: Luz Implacable. Fuerza 10, D12, inmune a debilitaciones
      y aplica dos Sellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951640920171
    m_Localized: "SERAPHEL - PHASE II : Lumi\xE8re implacable. Force 10, D12, immunis\xE9
      contre les malus et applique deux Sceaux."
    m_Metadata:
      m_Items: []
  - m_Id: 6120951640920172
    m_Localized: 'SERAPHEL: Giudizio di Luce su {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951640920173
    m_Localized: 'SERAPHEL: Judgement of Light on {0}.'
    m_Metadata:
      m_Items: []
