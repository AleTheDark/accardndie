    m_Metadata:
      m_Items: []
  - m_Id: 161363169307
    m_Localized: Construye un equipo equilibrado para la arena.
    m_Metadata:
      m_Items: []
  - m_Id: 161363169308
    m_Localized: GUARDAR
    m_Metadata:
      m_Items: []
  - m_Id: 161363169309
    m_Localized: "CAT\xC1LOGO DE TARJETAS"
    m_Metadata:
      m_Items: []
  - m_Id: 161363169311
    m_Localized: "carga v\xE1lida!"
    m_Metadata:
      m_Items: []
  - m_Id: 161363169313
    m_Localized: "CardDatabase no asignada: se utilizar\xE1 la carga predeterminada."
    m_Metadata:
      m_Items: []
  - m_Id: 161363169314
    m_Localized: "  - ELECCI\xD3N"
    m_Metadata:
      m_Items: []
  - m_Id: 161363169316
    m_Localized: "A\xD1ADIR"
    m_Metadata:
      m_Items: []
  - m_Id: 161363169317
    m_Localized: YA EN EL LOADOUT
    m_Metadata:
      m_Items: []
  - m_Id: 161363169318
    m_Localized: CARGA COMPLETA
    m_Metadata:
      m_Items: []
  - m_Id: 161363169319
    m_Localized: TU CARGA
    m_Metadata:
      m_Items: []
  - m_Id: 161363169320
    m_Localized: Toca una tarjeta para eliminarla
    m_Metadata:
      m_Items: []
  - m_Id: 161363169322
    m_Localized: VICTORIA
    m_Metadata:
      m_Items: []
  - m_Id: 161363169323
    m_Localized: DERROTA
    m_Metadata:
      m_Items: []
  - m_Id: 161363169324
    m_Localized: RESULTADO DE LA ARENA
    m_Metadata:
      m_Items: []
  - m_Id: 161363169325
    m_Localized: Tu leyenda avanza
    m_Metadata:
      m_Items: []
  - m_Id: 161363169326
    m_Localized: Reorganiza el equipamiento y regresa a la arena.
    m_Metadata:
      m_Items: []
  - m_Id: 161363169327
    m_Localized: CONTINUAR
    m_Metadata:
      m_Items: []
  - m_Id: 161363169328
    m_Localized: "Ganancia/p\xE9rdida por falta de tiempo."
    m_Metadata:
      m_Items: []
  - m_Id: 161363169329
    m_Localized: El oponente ha abandonado.
    m_Metadata:
      m_Items: []
  - m_Id: 161363169332
    m_Localized: "\xA1PROMOCIONADO!"
    m_Metadata:
      m_Items: []
  - m_Id: 161363169333
    m_Localized: Relegado.
    m_Metadata:
      m_Items: []
  - m_Id: 161363169334
    m_Localized: Partido amistoso (sin cambios de rango).
    m_Metadata:
      m_Items: []
  - m_Id: 161363169335
    m_Localized: 'LOGROS DESBLOQUEADOS:'
    m_Metadata:
      m_Items: []
  - m_Id: 161363169355
    m_Localized: "Resultado recibido del servidor, pero la repetici\xF3n local a\xFAn
      no muestra un equipo eliminado."
    m_Metadata:
      m_Items: []
  - m_Id: 161363169356
    m_Localized: "\xA1GANASTE ABANDONANDO A TU OPONENTE!"
    m_Metadata:
      m_Items: []
  - m_Id: 161363169357
    m_Localized: Perdiste por abandono.
    m_Metadata:
      m_Items: []
  - m_Id: 161363169368
    m_Localized: 'CONTRAATAQUE: '
    m_Metadata:
      m_Items: []
  - m_Id: 161363169369
    m_Localized: ataque imposible, giro perdido
    m_Metadata:
      m_Items: []
  - m_Id: 161363169378
    m_Localized: "m\xE1ximo"
    m_Metadata:
      m_Items: []
  - m_Id: 161363169379
    m_Localized: "m\xEDn."
    m_Metadata:
      m_Items: []
  - m_Id: 161363169380
    m_Localized: suma
    m_Metadata:
      m_Items: []
