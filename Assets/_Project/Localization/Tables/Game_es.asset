    m_Metadata:
      m_Items: []
  - m_Id: 161363169295
    m_Localized: El apodo debe tener al menos 3 caracteres.
    m_Metadata:
      m_Items: []
  - m_Id: 161363169296
    m_Localized: "Comprobaci\xF3n de apodo..."
    m_Metadata:
      m_Items: []
  - m_Id: 161363169298
    m_Localized: Apodo no disponible. Elige otro.
    m_Metadata:
      m_Items: []
  - m_Id: 161363169299
    m_Localized: "Abro el men\xFA..."
    m_Metadata:
      m_Items: []
  - m_Id: 161363169300
    m_Localized: "La autenticaci\xF3n de Unity no est\xE1 disponible."
