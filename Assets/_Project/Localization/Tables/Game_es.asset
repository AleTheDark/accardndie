    m_Localized: acquista classe {pendingClass}
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114390
    m_Localized: 'apri il secondo tutorial: IL MAGO'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114391
    m_Localized: apri modulo {nextModule}
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114392
    m_Localized: mago={flow.OwnsMage}; ladro={flow.OwnsRogue};
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114393
    m_Localized: tourSantuarioVisto={flow.SanctuaryTourSeen}; tourPendente={pendingTour};
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114394
    m_Localized: acquistoPendente={pendingClass}; prossimoModulo={nextModule}; atteso={expected}.
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114395
    m_Localized: 'Prima passa dal Santuario: ti aspetta il Mago.'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114396
    m_Localized: 'Prima passa dal Santuario: ti aspetta il Ladro.'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114397
    m_Localized: 'Prima dai un''occhiata al Santuario: ti spiego a cosa serve.'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114398
    m_Localized: 'Prima dai un''occhiata al Negozio: ti spiego a cosa serve.'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114399
    m_Localized: Si apre piu' avanti.
    m_Metadata:
      m_Items: []
  - m_Id: 6120951645114400
    m_Localized: 'Si apre completando il tutorial: {TutorialModuleCatalog.Title(nextModuleId)}.'
