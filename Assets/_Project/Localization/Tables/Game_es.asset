    m_Metadata:
      m_Items: []
  - m_Id: 2203246189777226
    m_Localized: ROLLO
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388980
    m_Localized: "CAMPA\xD1A COMPLETADA. Jefe final derrotado: icono de logro desbloqueado.
