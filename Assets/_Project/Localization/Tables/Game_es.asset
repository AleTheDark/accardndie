    m_Localized: TABERNA
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389317
    m_Localized: "Prepara tu formaci\xF3n: selecciona las cartas que quieres llevar
      a la batalla."
    m_Metadata:
      m_Items: []
  - m_Id: 2203246185582624
    m_Localized: "Sugerencias restauradas: reaparecer\xE1n la pr\xF3xima vez."
    m_Metadata:
      m_Items: []
  - m_Id: 2203246185583331
    m_Localized: 'Nigromante:'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246177194060
    m_Localized: 'ANUNCIO DE PRUEBA: NO HAY RED CONECTADA'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388959
    m_Localized: "DERROTA. La CPU ha eliminado tu alineaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 2203246189777085
    m_Localized: "VENDER AIRE NO ES GRAN COSA A\xDAN."
    m_Metadata:
      m_Items: []
  - m_Id: 2203246189776927
