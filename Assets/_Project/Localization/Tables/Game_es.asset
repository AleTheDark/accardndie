      m_Items: []
  - m_Id: 2203246181388547
    m_Localized: HABILITAR
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389313
    m_Localized: 'Tutorial no disponible: mano escrita incompleta.'
