  - m_Id: 6185852275167264
    m_Localized: Con il vantaggio di fazione, come si tira?
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167265
    m_Localized: Un dado solo
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167266
    m_Localized: Due dadi, tieni il migliore
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167267
    m_Localized: Due dadi, tieni il peggiore
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167268
    m_Localized: Con lo svantaggio di fazione, come si tira?
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167269
    m_Localized: Due dadi, tieni il migliore
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167270
    m_Localized: Un dado solo
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167271
    m_Localized: Due dadi, tieni il peggiore
    m_Metadata:
      m_Items: []
  - m_Id: 6185852275167272
    m_Localized: In un confronto neutro quanti dadi si tirano?
    m_Metadata:
      m_Items: []
