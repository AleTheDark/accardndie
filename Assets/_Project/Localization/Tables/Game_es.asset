      m_Items: []
  - m_Id: 2203246181389228
    m_Localized: CANCELAR
    m_Metadata:
      m_Items: []
  - m_Id: 2203246185582594
    m_Localized: 'Ataque cancelado:'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389311
    m_Localized: "Elige una clase: la primera carta ser\xE1 tu campe\xF3n de valor
      10."
    m_Metadata:
      m_Items: []
  - m_Id: 2203246189777247
    m_Localized: "PRUEBA DE CONSTELACI\xD3N DE VIGOR DEL MAGO"
    m_Metadata:
      m_Items: []
  - m_Id: 2203246185583229
    m_Localized: "Iniciativa lista: los valores m\xE1s bajos se implementan primero."
    m_Metadata:
      m_Items: []
  - m_Id: 2203246189777236
    m_Localized: RESULTADO
    m_Metadata:
      m_Items: []
  - m_Id: 2203246185582849
    m_Localized: "Volver\xE1 a la pantalla de inicio de sesi\xF3n. La campa\xF1a
      en curso ser\xE1 abandonada."
    m_Metadata:
      m_Items: []
  - m_Id: 2203246189777351
    m_Localized: Debes elegir un apodo para continuar.
    m_Metadata:
      m_Items: []
  - m_Id: 2203246189777228
    m_Localized: ROLLAR TODO
    m_Metadata:
      m_Items: []
  - m_Id: 2203246185582907
    m_Localized: 'MERCADO: Primero elige una tarjeta para vender.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246189777253
    m_Localized: JUGAR
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388941
    m_Localized: "\xA1NUEVO NIVEL!"
    m_Metadata:
      m_Items: []
  - m_Id: 2203246185583187
