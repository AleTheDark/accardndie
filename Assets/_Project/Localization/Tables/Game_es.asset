  - m_Id: 2203246185582608
    m_Localized: CAPITOLO 1 - impossibile creare una formazione entro potenza 24.
    m_Metadata:
      m_Items: []
  - m_Id: 2203246185582609
    m_Localized: AccardHint_
    m_Metadata:
