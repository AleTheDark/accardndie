  - m_Id: 6120950927888463
    m_Localized: SELEZIONA PEDINA
    m_Metadata:
      m_Items: []
  - m_Id: 6120950927888464
    m_Localized: "POTENZIA +1  \u2022  {0} ORO"
    m_Metadata:
      m_Items:
      - rid: 7214883363307127525
  - m_Id: 6120950927888465
    m_Localized: POTENZIAMENTO MAX
    m_Metadata:
      m_Items: []
  - m_Id: 6120950927888466
    m_Localized: SERVE RELIQUIA DEL FABBRO {0}
    m_Metadata:
      m_Items:
      - rid: 7214883363307127525
  - m_Id: 6120950927888467
    m_Localized: Scegli una pedina da potenziare. Servono le Reliquie del Fabbro
      del Santuario.
    m_Metadata:
      m_Items: []
  - m_Id: 6120950927888468
    m_Localized: "{0}  \u2022  Forza {1}\nPotenziamento massimo raggiunto"
    m_Metadata:
      m_Items:
      - rid: 7214883363307127525
  - m_Id: 6120950927888469
    m_Localized: "{0}  \u2022  Forza {1}\nUpgrade +1: {2} oro"
    m_Metadata:
      m_Items:
      - rid: 7214883363307127525
  - m_Id: 6120950927888470
    m_Localized: 'MERCATO: scegli una pedina del mazzo da potenziare.'
    m_Metadata:
      m_Items: []
  - m_Id: 6120950927888471
    m_Localized: 'MERCATO: questa pedina ha gia'' raggiunto il massimo di 2 potenziamenti.'
    m_Metadata:
      m_Items: []
  - m_Id: 6120950927888472
    m_Localized: 'MERCATO: il banco Potenzia e'' chiuso fino alla prossima stanza.'
    m_Metadata:
      m_Items: []
  - m_Id: 6120950927888473
    m_Localized: 'MERCATO: sblocca la Reliquia del Fabbro {0} al Santuario.'
    m_Metadata:
      m_Items:
      - rid: 7214883363307127525
  - m_Id: 6120950927888474
    m_Localized: 'MERCATO: servono {0} oro per il potenziamento, disponibili {1}.'
    m_Metadata:
      m_Items:
      - rid: 7214883363307127525
  - m_Id: 6120950927888475
    m_Localized: 'MERCATO: questa pedina non puo'' essere potenziata adesso.'
    m_Metadata:
      m_Items: []
  - m_Id: 6120950927888476
    m_Localized: 'POTENZIAMENTO MERCATO - {0} ottiene +1 Forza. Primo affare: gratis.'
    m_Metadata:
      m_Items:
      - rid: 7214883363307127525
  - m_Id: 6120950927888477
    m_Localized: 'POTENZIATA: {0} ottiene +1 Forza permanente. Primo affare: gratis.'
    m_Metadata:
      m_Items:
      - rid: 7214883363307127525
  - m_Id: 6120950927888478
    m_Localized: POTENZIAMENTO MERCATO - {0} ottiene +1 Forza, -{1} oro.
    m_Metadata:
      m_Items:
      - rid: 7214883363307127525
  - m_Id: 6120950927888479
    m_Localized: 'POTENZIATA: {0} ottiene +1 Forza permanente per {1} oro.'
    m_Metadata:
      m_Items:
      - rid: 7214883363307127525
  - m_Id: 6120950927888480
    m_Localized: '{0}

      Recupero dal Cimitero'
    m_Metadata:
      m_Items:
