  - m_Id: 6120951649309083
    m_Localized: TI STA PIACENDO?
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309084
    m_Localized: ARE YOU ENJOYING IT?
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309085
    m_Localized: "GEF\xC4LLT ES DIR?"
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309086
    m_Localized: "\xBFTE EST\xC1 GUSTANDO?"
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309087
    m_Localized: "\xC7A TE PLA\xCET ?"
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309088
    m_Localized: 'Hai appena chiuso il primo capitolo.

      Quante stelle daresti
      ad AcCard N'' Die?'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309089
    m_Localized: INVIA
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309090
    m_Localized: LASCI UNA RECENSIONE?
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309091
    m_Localized: LEAVE A REVIEW?
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309092
    m_Localized: "M\xD6CHTEST DU UNS BEWERTEN?"
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309093
    m_Localized: "\xBFQUIERES DEJAR UNA RESE\xD1A?"
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309094
    m_Localized: LAISSER UN AVIS ?
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309095
    m_Localized: 'Hai appena chiuso il primo capitolo.


      Una recensione sul
      Play Store'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309096
    m_Localized: aiuta altri giocatori a trovare il gioco.
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309097
    m_Localized: RECENSISCI
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309098
    m_Localized: NON ORA
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309099
    m_Localized: GRAZIE
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309100
    m_Localized: THANK YOU
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309101
    m_Localized: DANKE
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309102
    m_Localized: GRACIAS
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309103
    m_Localized: MERCI
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309104
    m_Localized: 'Il tuo voto resta qui nel gioco.


      Se qualcosa non ti ha
      convinto, scrivilo:'
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309105
    m_Localized: e' cosi' che il gioco migliora.
    m_Metadata:
      m_Items: []
  - m_Id: 6120951649309106
    m_Localized: SCRIVICI
    m_Metadata:
      m_Items: []
