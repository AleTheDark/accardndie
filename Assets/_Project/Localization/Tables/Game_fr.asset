      - rid: 7214883319116726833
  - m_Id: 2986667585474560
    m_Localized: "Ascendant S\xE9raphin"
    m_Metadata:
      m_Items: []
  - m_Id: 2986667585474561
    m_Localized: "\"Phase II - Divinit\xE9 de la Lumi\xE8re.\nPuissance 10, Vigueur
      D12.\n\nLumi\xE8re r\xE9g\xE9n\xE9ratrice\_: lorsqu'elle atteint 10 Mana, elle
      la consomme et r\xE9cup\xE8re 8 PV, jusqu'\xE0 un maximum de 80.\n\nPuret\xE9
      absolue\_: immunis\xE9e contre toutes les p\xE9nalit\xE9s.\n\nDouble Sceau\_:
      s'il surmonte la d\xE9fense, il applique 2 Sceaux.\n\nConviction croissante\_:
      +2 au total d'attaque pour chacun. Sceau sur la cible.\n\nCondamnation des
      Trois Sceaux : \xE0 3 Sceaux la cible meurt automatiquement.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2986667585474562
    m_Localized: "S\xE9raphin"
    m_Metadata:
      m_Items: []
  - m_Id: 2986667585474563
    m_Localized: "\"Phase I - Pr\xEAtresse de la Lumi\xE8re. \nPuissance 8, Vigueur
      D10, 80 PV.\n\nLumi\xE8re r\xE9g\xE9n\xE9rante : lorsqu'elle atteint 10 Mana,
      elle la consomme et r\xE9cup\xE8re 4 PV, jusqu'\xE0 un maximum de 80.\n\nSceau
      sacr\xE9 : s'il surmonte la d\xE9fense, il n'\xE9limine pas la cible, mais
      applique 1 Sceau.\n\nConviction croissante : +2 au total d'attaque pour chaque
      Sceau d\xE9j\xE0 pr\xE9sent sur la cible.\n\nCondamnation des Trois Sceaux
      : \xE0 3 Sceaux la cible meurt automatiquement.\""
    m_Metadata:
      m_Items: []
