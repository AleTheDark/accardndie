  - m_Id: 2203246181389276
    m_Localized: ' Le carte schierate nella prossima vittoria non entreranno in cooldown.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389277
    m_Localized: ' Evento misterioso: il presagio dello scenario si intensifica.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389278
    m_Localized: ' Nel prossimo combattimento gli eroi caduti valgono EXP pari alla
      loro forza.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389279
    m_Localized: PROVA CONSUMABILE
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389280
    m_Localized: ' Nel prossimo combattimento gli Assassini partiranno ultimi in
      iniziativa.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389281
    m_Localized: ' Nel prossimo combattimento i Paladini aprono il duello: +2 ai
      tuoi, -1 alla CPU.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389282
    m_Localized: ' Nel prossimo combattimento tutti i Guerrieri useranno un dado
      Vigore inferiore.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389283
    m_Localized: ' Presagio oscuro: il prossimo mostro sara di un tier piu alto.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389284
    m_Localized: ' Nessun effetto.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389285
    m_Localized: ': nessuna carta disponibile.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389286
    m_Localized: ': nessuna carta nuova disponibile.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389287
    m_Localized: ': ottieni'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389288
    m_Localized: SCAMBIO DELLA FORMAZIONE
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389289
    m_Localized: RECUPERO -
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389290
    m_Localized: ' torna nel mazzo.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389291
    m_Localized: ' Recuperi'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389292
    m_Localized: ' dal cimitero.'
    m_Metadata:
