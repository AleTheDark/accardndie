  - m_Id: 161363169334
    m_Localized: Match amical (aucun changement de classement).
    m_Metadata:
      m_Items: []
  - m_Id: 161363169335
    m_Localized: "R\xC9ALISATIONS D\xC9BLOQU\xC9ES\_:"
    m_Metadata:
      m_Items: []
  - m_Id: 161363169355
    m_Localized: "R\xE9sultat re\xE7u du serveur, mais le replay local ne montre
      toujours pas d'\xE9quipe \xE9limin\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 161363169356
    m_Localized: "VOUS AVEZ GAGN\xC9 EN ABANDONNEZ VOTRE ADVERSAIRE\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 161363169357
    m_Localized: You lost by abandonment.
    m_Metadata:
      m_Items: []
  - m_Id: 161363169368
    m_Localized: 'CONTRE-ATTAQUE : '
    m_Metadata:
      m_Items: []
  - m_Id: 161363169369
    m_Localized: attaque impossible, tour perdu
    m_Metadata:
      m_Items: []
  - m_Id: 161363169378
    m_Localized: maximum
    m_Metadata:
      m_Items: []
  - m_Id: 161363169379
    m_Localized: min
    m_Metadata:
      m_Items: []
  - m_Id: 161363169380
    m_Localized: somme
    m_Metadata:
      m_Items: []
  - m_Id: 161363169381
    m_Localized: "r\xE9sultat"
    m_Metadata:
      m_Items: []
  - m_Id: 1894294392832
    m_Localized: "\xAB\_OVERKILL\_!\_\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587136
    m_Localized: Meurtrier
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587137
    m_Localized: Guerrier
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587138
    m_Localized: Magicien
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587139
    m_Localized: Paladin
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587140
    m_Localized: Voleur
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587141
    m_Localized: Chasseur
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587142
    m_Localized: Barbare
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587143
    m_Localized: "N\xE9cromancien"
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587144
    m_Localized: "Pr\xEAtre"
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587145
    m_Localized: Fort
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587146
    m_Localized: Intelligent
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587147
    m_Localized: Magique
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587148
    m_Localized: "EN ATTAQUE : SI BESOIN, RETRAITE \xC0 SON NIVEAU"
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587151
    m_Localized: "LEVER UN ALLI\xC9 \xC9LIMIN\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587153
    m_Localized: "CHOISISSEZ UN ENNEMI\_: SAUTER UN TOUR"
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587154
    m_Localized: "PROCHAINE ATTAQUE\_: D\xC9 SOMME DE VIGUEUR + D\xC9 \xC9TAPE -1"
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587155
    m_Localized: "MALUS PEUT \xCATRE COMBIN\xC9 AVEC LES D\xC9S DE VIGUEUR ENNEMI"
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587156
    m_Localized: "IL RENFORCE OU PROT\xC8GE UN ALLI\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587157
    m_Localized: "Activez la capacit\xE9 : lors de votre prochaine attaque, lancez
      le d\xE9 Vigueur et un d\xE9 un cran plus bas, puis additionnez les r\xE9sultats."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587159
    m_Localized: "Le Paladin peut se renforcer ou prot\xE9ger un alli\xE9 en d\xE9viant
      une attaque vers lui, il se d\xE9fendra avec un avantage."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587160
    m_Localized: "Comp\xE9tence passive : en attaquant, si le total n'est pas suffisant
      pour gagner, relancez une fois chaque d\xE9 d'Endurance avec un r\xE9sultat
      \xE9gal ou inf\xE9rieur \xE0 son niveau (en PvP, le num\xE9ro de la manche).
      S'il est d\xE9j\xE0 gagnant, il ne se retire pas."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587161
    m_Localized: 'Choisissez un adversaire : sautez son prochain tour.'
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587163
    m_Localized: "Choisissez un ennemi : lors du prochain affrontement, son d\xE9
      d'Endurance diminue d'une taille. Plus de notes s'accumulent, jusqu'\xE0 un
      minimum de D2."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587164
    m_Localized: "Ram\xE8ne un alli\xE9 \xE9limin\xE9 qui agit imm\xE9diatement apr\xE8s
      vous."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587166
    m_Localized: "Aucune comp\xE9tence de combat."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587168
    m_Localized: Lorsqu'un jeton meurt, chaque carte Homme fort avec l'aura active
      gagne +1 permanent.
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587169
    m_Localized: "Les cartes \xE0 puce attaquent les ennemis avec des bonus ou des
      p\xE9nalit\xE9s avec avantage."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587170
    m_Localized: "Les cartes magiques sont d\xE9fendues avec un d\xE9 Vigor d'une
      taille plus grande."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587171
    m_Localized: Aucun effet.
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587172
    m_Localized: "Lors d'un affrontement, si la Puissance du Guerrier est inf\xE9rieure
      \xE0 celle de l'adversaire, le Guerrier re\xE7oit +2 au total."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587173
    m_Localized: "La Fureur vaut +3 au lieu de +2, aussi bien en attaque qu'en d\xE9fense."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587174
    m_Localized: "Lorsqu'un Paladin survit \xE0 une d\xE9fense, il contre-attaque
      avec +1."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587175
    m_Localized: "La capacit\xE9 passive du Voleur fonctionne \xE9galement sur la
      d\xE9fense : si le total n'est pas suffisant pour r\xE9sister, relancez une
      fois chaque d\xE9 d'Endurance avec un r\xE9sultat \xE9gal ou inf\xE9rieur \xE0
      son niveau (en PvP, le num\xE9ro de la manche). S\u2019il r\xE9siste d\xE9j\xE0,
      il ne recule pas."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587176
    m_Localized: "Lorsqu'un Assassin neutralise un ennemi, cet ennemi subit \xE9galement
      -1 permanent."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587178
    m_Localized: "Lorsqu'un sorcier dot\xE9 de cette aura meurt suite \xE0 une attaque,
      l'attaquant qui l'a \xE9limin\xE9 subit un -2 permanent."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587179
    m_Localized: "La premi\xE8re fois qu'un alli\xE9 est \xE9limin\xE9, il reste
      sur le terrain en tant qu'Esprit pour un dernier tour."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587180
    m_Localized: "La b\xE9n\xE9diction vaut +3 au lieu de +2."
    m_Metadata:
      m_Items: []
  - m_Id: 1894298587181
    m_Localized: "Le d\xE9savantage en attaque est \xE9limin\xE9 et le tir devient
      neutre."
    m_Metadata:
      m_Items: []
