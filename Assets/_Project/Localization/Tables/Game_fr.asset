      m_Items: []
  - m_Id: 11648701992967
    m_Localized: Consommable
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992968
    m_Localized: "R\xE9v\xE9lez le contenu des trois portes lors du prochain choix
      de chemin. Des \xE9tiquettes apparaissent sur les portes avant d'entrer."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992969
    m_Localized: "Ressuscite toutes les cartes du cimeti\xE8re et les remet dans
      le deck. Ne peut pas \xEAtre utilis\xE9 au combat."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992970
    m_Localized: "D\xE9g\xE8le toutes les cartes pendant le temps de recharge et
      les remet dans le deck. Ne peut pas \xEAtre utilis\xE9 au combat."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992971
    m_Localized: "Augmentez votre d\xE9 d'endurance d'attaque d'un cran pour la pi\xE8ce
      actuelle ou la pi\xE8ce suivante. Ne peut pas \xEAtre utilis\xE9 dans les salles
      Boss ou Miniboss."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992972
    m_Localized: "Augmente de mani\xE8re permanente un pion d\xE9ploy\xE9 sur le
      terrain de +2. Chaque carte ne peut recevoir qu'un seul Ruby Seal."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992973
    m_Localized: "Doublez toute l\u2019exp\xE9rience acquise dans la pi\xE8ce voisine."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992974
    m_Localized: Objet consommable de campagne.
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992977
    m_Localized: "Empower ne peut pas \xEAtre utilis\xE9 dans les salles Boss ou
      Miniboss."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992978
    m_Localized: "CONSOMMABLE - Empower bloqu\xE9 : Salle Boss/Miniboss."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992979
    m_Localized: "D\xE9tecteur activ\xE9 : le sort des trois portes est r\xE9v\xE9l\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992980
    m_Localized: "D\xE9tecteur activ\xE9 : la s\xE9lection de porte suivante indiquera
      le sort de chaque porte."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992981
    m_Localized: "CONSOMMABLE - D\xE9tecteur activ\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992986
    m_Localized: "Renforcement activ\xE9\_: votre d\xE9 d'endurance d'attaque monte
      d'un cran pour cette pi\xE8ce ou la suivante."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992987
    m_Localized: "CONSOMMABLE - Empower pr\xEAt : D\xE9 de Force d'Attaque +1 pas
      dans la pi\xE8ce actuelle ou suivante."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992988
    m_Localized: "Double EXP activ\xE9 : la salle suivante donnera une double exp\xE9rience."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992989
    m_Localized: "CONSOMMABLE - Double EXP pr\xEAt pour la pi\xE8ce suivante."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992990
    m_Localized: "Ruby Seal : Aucun pion valide d\xE9ploy\xE9 sur le terrain."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992991
    m_Localized: "CONSOMMABLE - Ruby Seal bloqu\xE9 : aucune cible valide."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992992
    m_Localized: "Ruby Seal pr\xEAt : choisissez un pion d\xE9ploy\xE9 sur le terrain."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992993
    m_Localized: 'CONSOMMABLE - Ruby Seal : choix de cible actif.'
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992994
    m_Localized: "Ruby Seal : Choisissez un jeton d\xE9ploy\xE9, actif et pas encore
      scell\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 11648701992995
    m_Localized: "Ruby Seal : Cette carte est d\xE9j\xE0 scell\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 11648706187264
    m_Localized: "SACOCHE - vide\_: aucun consommable dans cette course."
    m_Metadata:
      m_Items: []
  - m_Id: 11648706187266
    m_Localized: "CONSOMMABLE - Double EXP consomm\xE9e."
    m_Metadata:
      m_Items: []
