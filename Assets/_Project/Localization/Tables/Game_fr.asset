  - m_Id: 2203246181388885
    m_Localized: Aura Codex
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388887
    m_Localized: CODICE DELLE AURE
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388888
    m_Localized: Close Aura Codex
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388889
    m_Localized: Aura Codex Scroll
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388890
    m_Localized: Viewport
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388891
    m_Localized: Content
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388893
    m_Localized: 'Schieri sempre 3 carte. In base alla loro composizione si attiva
      UNA sola aura, con questa priorita'':'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388894
    m_Localized: "\u2022 3 carte della stessa CLASSE  ->  Aura di Classe"
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388895
    m_Localized: "\u2022 3 cartes de la même FACTION (classes différentes) -> Aura
      de faction"
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388896
    m_Localized: "\u2022 1 Fortuza + 1 Astuta + 1 Magica  ->  Aura di Formazione"
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388897
    m_Localized: 'L''Aura de classe remplace l''Aura de faction : elles ne se cumulent pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181388898
    m_Localized: "Factions : Force (Guerrier, Barbare, Paladin) \xB7 Ruse (Voleur,
      Assassin, Chasseur) \xB7 Magie (Mage, Nécromancien, Prêtre)"
