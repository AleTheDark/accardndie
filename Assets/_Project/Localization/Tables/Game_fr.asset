  - m_Id: 2203246181389141
    m_Localized: 'CPU ABILITA:'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389142
    m_Localized: ' prepara un colpo pesante: tirera il dado Vigore e un dado di uno
      step inferiore.'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389143
    m_Localized: ' e infligge -1 permanente'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389144
    m_Localized: 'CPU ASSASSINO:'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389146
    m_Localized: 'Grazie all''abilita del mago, il prossimo dado Vigore di {battleCardState.Card.Name}
      scende di {num} step: usera un D{endDieSides}.'
    m_Metadata:
      m_Items:
      - rid: 7214883319116726833
  - m_Id: 2203246181389147
    m_Localized: si prepara a difendersi con vantaggio
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389148
    m_Localized: proteggera
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389149
    m_Localized: 'CPU PALADINO:'
    m_Metadata:
      m_Items: []
  - m_Id: 2203246181389150
    m_Localized: 'CPU CACCIATORE: {card.Card.Name} marca {battleCardState.Card.Name}.
      Bersaglio marcato: chi lo attacca prende +{HunterMarkValueFor(card)}.'
    m_Metadata:
      m_Items:
      - rid: 7214883319116726833
  - m_Id: 2203246181389151
