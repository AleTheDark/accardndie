      m_Items:
      - rid: 7214883181289013806
  - m_Id: 161363169341
    m_Localized: '{0} schiera {1} ({2}).'
    m_Metadata:
      m_Items:
      - rid: 7214883181289013806
  - m_Id: 161363169342
    m_Localized: 'Aure: {0} contro {1}.'
    m_Metadata:
      m_Items:
      - rid: 7214883181289013806
  - m_Id: 161363169343
    m_Localized: "{0} \xE8 inibito e salta il turno."
