      m_Items:
      - rid: 7214883181289013806
  - m_Id: 161363169348
    m_Localized: '{0} entra in Furia (+{1}).'
    m_Metadata:
      m_Items:
      - rid: 7214883181289013806
  - m_Id: 161363169349
    m_Localized: 'Aura Might: {0} guadagna +1 permanente.'
    m_Metadata:
      m_Items:
      - rid: 7214883181289013806
  - m_Id: 161363169350
    m_Localized: 'Aura Mago: {0} subisce -{1} permanente.'
