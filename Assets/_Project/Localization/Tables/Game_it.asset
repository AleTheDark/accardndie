      m_Items:
      - rid: 7214883181289013806
  - m_Id: 161363169366
    m_Localized: '{0} prepara un colpo a due dadi.'
    m_Metadata:
      m_Items:
      - rid: 7214883181289013806
  - m_Id: 161363169367
    m_Localized: '{0} rialza {1}.'
