      m_Items:
      - rid: 7214883181289013806
  - m_Id: 161363169346
    m_Localized: '{0} si difende con vantaggio.'
    m_Metadata:
      m_Items:
      - rid: 7214883181289013806
  - m_Id: 161363169347
    m_Localized: '{0} si sacrifica: +{1} a {2}.'
