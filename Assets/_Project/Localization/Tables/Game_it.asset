      m_Items:
      - rid: 7214883181289013806
  - m_Id: 161363169339
    m_Localized: 'Round decisivo: scegli {0} carte tra tutte le 9.'
    m_Metadata:
      m_Items:
      - rid: 7214883181289013806
  - m_Id: 161363169340
    m_Localized: 'Iniziative schieramento: {0} apre la sequenza.'
