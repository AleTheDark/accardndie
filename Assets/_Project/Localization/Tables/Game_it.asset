      m_Items:
      - rid: 7214883181289013806
  - m_Id: 161363169353
    m_Localized: '{0} abbandona: vittoria a {1}.'
    m_Metadata:
      m_Items:
      - rid: 7214883181289013806
  - m_Id: 161363169354
    m_Localized: Round {0} a {1}. Parziale {2}-{3}.
    m_Metadata:
      m_Items:
      - rid: 7214883181289013806
  - m_Id: 161363169355
    m_Localized: Risultato ricevuto dal server, ma il replay locale non mostra ancora
      una formazione eliminata.
    m_Metadata:
      m_Items: []
  - m_Id: 161363169356
    m_Localized: HAI VINTO PER ABBANDONO DELL'AVVERSARIO!
    m_Metadata:
      m_Items: []
