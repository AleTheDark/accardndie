# --- Unity ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
ExportedObj/
crashlogs/
sysinfo.txt
*.stackdump
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Build output del progetto
output*
WebGLBuild/
webgl.zip
publish-linux/
.utmp/
_Recovery/
_Recovery_fuori_da_assets/
tmp/
nul+

# Progetti generati da Unity (rigenerati a ogni apertura)
*.csproj
*.sln
*.slnx
*.user
.vs/
.vsconfig
.idea/

# --- Server .NET ---
# I progetti del server sono scritti a mano, non generati da Unity: la regola
# *.csproj qui sopra li prenderebbe, e senza di loro il server non si compila
# da un clone pulito.
!Server/**/*.csproj
[Bb]in/
Server/**/appsettings.Development.json
Server/AccardND.Server/accounts.json
# Database SQLite locale (dati runtime, non versionati)
Server/AccardND.Server/*.db
Server/AccardND.Server/*.db-wal
Server/AccardND.Server/*.db-shm

# Screenshot di debug/QA (solo materiale di lavoro locale)
Assets/Screenshots/
Assets/Screenshots.meta
Assets/_Project/Screenshots/
Assets/_Project/Screenshots.meta
Documentation/

# Dump di analisi asset generati dagli script di manutenzione
/alive_reason.json
/dead.json
/orphans.json
/unref.json
/used.json
/where.json

# Il vecchio progetto archiviato mantiene tutto com'era
!old_project/**
